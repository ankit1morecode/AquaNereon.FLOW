# Copy to .env.local and fill in. Nothing here is required — without a key the
# map falls back to keyless OpenStreetMap tiles, darkened in CSS.

# --- Basemap -------------------------------------------------------------
# CARTO Basemaps key. https://carto.com/basemaps
# Note: Vite inlines VITE_* into the client bundle, so this is visible to
# anyone loading the site. Restrict it by domain in the CARTO dashboard.
VITE_CARTO_KEY=
# dark_all | dark_nolabels | voyager | positron
VITE_CARTO_STYLE=dark_all

# Or point at any other tile provider entirely. Setting this overrides CARTO
# and disables the darkening filter, on the assumption that a provider you
# chose deliberately already looks the way you want.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# --- Backend -------------------------------------------------------------
# Unset: the platform simulator runs in the browser.
# Set: the frontend talks to a real FastAPI backend at this base URL.
VITE_API_BASE_URL=
